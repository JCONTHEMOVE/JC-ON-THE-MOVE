# Copy to .env on the server. Do not commit the real .env file.

# App
NODE_ENV=production
PORT=5000
APP_URL=https://staging.jconthemove.com
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Caddy / HTTPS
SITE_DOMAIN=staging.jconthemove.com
ACME_EMAIL=upmichiganstatemovers@gmail.com

# PostgreSQL container defaults.
# If you change POSTGRES_PASSWORD, update DATABASE_URL to match.
POSTGRES_USER=jconthemove
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=jconthemove
DATABASE_URL=postgresql://jconthemove:replace-with-a-strong-database-password@db:5432/jconthemove

# Square payments
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=replace-with-square-token
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://staging.jconthemove.com/api/webhooks/square
# Public Square-hosted eGift card order page. VITE_ values are embedded at build time.
VITE_SQUARE_EGIFT_URL=
# Keep false until the production webhook subscriptions and start timestamp
# are ready. Purchases before START_AT never earn a retroactive bonus.
GIFT_CARD_BONUS_ENABLED=false
# Independent launch switch: keep false through the owner-controlled $50 test.
GIFT_CARD_BONUS_PUBLIC_MARKETING_ENABLED=false
GIFT_CARD_BONUS_START_AT=

# Company defaults
COMPANY_EMAIL=upmichiganstatemovers@gmail.com
COMPANY_PHONE=906-285-9312
ADMIN_EMAIL=upmichiganstatemovers@gmail.com
ADMIN_PHONE_NUMBER=

# Email / SMS integrations
SENDGRID_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Job lifecycle webhooks, including Discord channel notifications.
# Comma-separate multiple Discord/generic webhook URLs.
JC_JOB_EVENT_WEBHOOK_URLS=

# Google integrations
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://staging.jconthemove.com/api/auth/google/callback
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT_ID=

# JCMOVES / crypto features
MOONSHOT_TOKEN_ADDRESS=
TREASURY_WALLET_PUBLIC_KEY=
TREASURY_WALLET_PRIVATE_KEY=
VITE_SOLANA_RPC_URL=
# Automatic recovery for jobs that become paid after completion. Keep false
# until the owner-controlled live reconciliation test passes. The admin-only
# manual reconciliation endpoint remains available while this is false.
JCMOVES_AUTO_PAYMENT_REWARDS_ENABLED=false
JCMOVES_PAYMENT_REWARD_RECONCILE_MINUTES=5
BTC_WALLET_ADDRESS=
CRYPTO_PAYMENTS_ENABLED=false
CRYPTO_PAYMENTS_PROVIDER=bitpay
BITPAY_ENV=sandbox
BITPAY_API_TOKEN=
BITPAY_WEBHOOK_SECRET=
# Set these only after the BitPay dashboard settlement split is configured
# and email-confirmed as 100% BTC. The app refuses Lightning job checkout
# until this operational attestation is present.
BITPAY_BTC_SETTLEMENT_CURRENCY=BTC
BITPAY_BTC_SETTLEMENT_PERCENT=100
# Preserve every received crypto asset in-kind. USD remains an accounting
# valuation only. Any future conversion must be a separate audited admin act.
CRYPTO_TREASURY_CUSTODY_POLICY=preserve_received_asset
CRYPTO_TREASURY_CONVERSION_POLICY=manual_only

# Browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:upmichiganstatemovers@gmail.com
VITE_VAPID_PUBLIC_KEY=

# Native/mobile builds only, normally blank for same-origin web hosting.
VITE_API_BASE_URL=

# Railway production verification. Railway deploys the main branch through its
# Git integration; GitHub verifies the public commit after each push.
PUBLIC_HEALTH_URL=https://www.jconthemove.com/api/health
CUSTOM_DOMAIN_HEALTH_URL=https://www.jconthemove.com/api/health
EXPECTED_HOSTING_PROVIDER=railway
# Optional AI background generation for crew marketing creatives. Exact ad text
# is always composited by the application after the background is selected.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# JC Marketing Bot. The scheduler generates a proposal at 6:30 AM Central;
# publishing always remains owner/admin approved in v1.
MARKETING_BOT_ENABLED=false
MARKETING_BOT_SCHEDULER_ENABLED=false
AI_GATEWAY_API_KEY=
MARKETING_AI_MODEL=openai/gpt-5.4-mini

# Meta organic publishing (approved Page + linked professional Instagram).
META_GRAPH_API_VERSION=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Per-representative Facebook Page OAuth. Tokens are encrypted independently
# from the company Page token. Keep the pilot allowlist scoped to Matt until
# Meta App Review and the wider representative rollout are complete.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://www.jconthemove.com/api/crew/marketing-bot/meta/callback
META_OAUTH_TOKEN_ENCRYPTION_KEY=
MARKETING_META_PILOT_REP_SLUGS=matt
MARKETING_COMPANY_META_IMPORT_ENABLED=false

# Google Business Profile organic posts (approved API access + one location).
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_BUSINESS_REFRESH_TOKEN=

# Required only for device-uploaded or AI-generated creative backgrounds.
# The approved crew-ramp photo workflow works without object storage.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=