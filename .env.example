# Copy to .env on the server. Do not commit the real .env file.

# App
NODE_ENV=production
PORT=5000
APP_URL=https://staging.jconthemove.com
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Caddy / HTTPS
SITE_DOMAIN=staging.jconthemove.com
ACME_EMAIL=upmichiganstatemovers@gmail.com

# PostgreSQL container defaults.
# If you change POSTGRES_PASSWORD, update DATABASE_URL to match.
POSTGRES_USER=jconthemove
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=jconthemove
DATABASE_URL=postgresql://jconthemove:replace-with-a-strong-database-password@db:5432/jconthemove

# Square payments
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=replace-with-square-token

# Company defaults
COMPANY_EMAIL=upmichiganstatemovers@gmail.com
COMPANY_PHONE=906-285-9312
ADMIN_EMAIL=upmichiganstatemovers@gmail.com
ADMIN_PHONE_NUMBER=

# Email / SMS integrations
SENDGRID_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Job lifecycle webhooks, including Discord channel notifications.
# Comma-separate multiple Discord/generic webhook URLs.
JC_JOB_EVENT_WEBHOOK_URLS=

# Google integrations
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://staging.jconthemove.com/api/auth/google/callback
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT_ID=

# JCMOVES / crypto features
MOONSHOT_TOKEN_ADDRESS=
TREASURY_WALLET_PUBLIC_KEY=
TREASURY_WALLET_PRIVATE_KEY=
VITE_SOLANA_RPC_URL=
BTC_WALLET_ADDRESS=
CRYPTO_PAYMENTS_ENABLED=false
CRYPTO_PAYMENTS_PROVIDER=bitpay
BITPAY_ENV=sandbox
BITPAY_API_TOKEN=
BITPAY_WEBHOOK_SECRET=

# Browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:upmichiganstatemovers@gmail.com
VITE_VAPID_PUBLIC_KEY=

# Native/mobile builds only, normally blank for same-origin web hosting.
VITE_API_BASE_URL=

# Railway production verification. Railway deploys the main branch through its
# Git integration; GitHub verifies the public commit after each push.
PUBLIC_HEALTH_URL=https://www.jconthemove.com/api/health
CUSTOM_DOMAIN_HEALTH_URL=https://www.jconthemove.com/api/health
EXPECTED_HOSTING_PROVIDER=railway
